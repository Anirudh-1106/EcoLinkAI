# =============================================
# EcoLinkAI – Backend Environment Variables
# =============================================
# Copy this file to .env and fill in values.

# development | production
# Setting this to "production" makes the app refuse to start on any of the
# development defaults below, rather than quietly running on credentials that
# are committed to this repository.
ENVIRONMENT=development

# Database
DATABASE_URL=postgresql://postgres:postgres123@localhost:5432/ecolinkai

# Security
# SECRET_KEY signs every login token, so anyone who knows it can mint one for
# any account. Generate your own and never commit it:
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
# Use a different key in each environment; replacing it just logs everyone out.
SECRET_KEY=change-this-to-a-random-secret-key
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480

# CORS (comma-separated origins)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# AI model checkpoint directory
MODEL_PATH=../ai/checkpoints

# Debug mode
DEBUG=False
